# Copy to `cardsdeven/.env` for local `npm run dev` / `npm run build`.
# Netlify: set the same keys (VITE_*) in Site configuration → Environment variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: same Gemini key as Netlify function if you run tooling locally
GEMINI_API_KEY=
