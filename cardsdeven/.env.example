# Copy to `cardsdeven/.env` for local `npm run dev` / `npm run build`.
# Optional: App.jsx falls back to bundled defaults if you leave these blank.
# Netlify / other hosts: set VITE_* to override per environment.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: same Gemini key as Netlify function if you run tooling locally
GEMINI_API_KEY=
