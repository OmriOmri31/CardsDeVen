# Copy to `.env` in this directory and/or `cardsdeven/.env` as needed.
# Never commit real values.

# Behatsdaa scraper login (scraper.py)
BEHATSDAA_ID=

# Gemini (scraper embeddings + Netlify chat)
GEMINI_API_KEY=

# Firebase Admin (scraper.py OTP polling) — use ONE of:
# A) Path to service account JSON file (local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=
# B) Entire service account JSON on one line (GitHub Actions / CI often use secrets)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Realtime Database URL (same project as the service account)
FIREBASE_DATABASE_URL=

# Optional: RTDB path for OTP inbox (default: secret_otp_drop_zone_xyz123)
# FIREBASE_OTP_REF=secret_otp_drop_zone_xyz123

# Standard Google env alternative to FIREBASE_SERVICE_ACCOUNT_PATH:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Set on CI so the workflow step commits JSON (scraper also respects this):
# SKIP_GIT_PUSH=1

# Site loads slim JSON only: cardsdeven/public/behatsdaa_deals.json, pais_plus_deals.json
# Full scrape outputs with vectors stay local: data.json, pais_plus_data.json (gitignored)
